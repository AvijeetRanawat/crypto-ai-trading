# Options: COINDCX, BINANCE
EXCHANGE=COINDCX
COINDCX_API_KEY=your_api_key_here
COINDCX_API_SECRET=your_api_secret_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Optional alias supported by config (if you use this name elsewhere)
BINANCE_SECRET_KEY=your_binance_api_secret_here
COINDCX_REST_BASE_URL=https://api.coindcx.com
BINANCE_REST_BASE_URL=https://api.binance.us
# Options: SIMULATION, LIVE
TRADING_MODE=SIMULATION
BLUE_CHIP_WHITELIST=BTCUSDT,ETHUSDT,SOLUSDT,ETHBTC,SOLBTC,SOLETH

# Profit-first safety defaults
ENABLE_PERIODIC_REVIEW=false
ENABLE_DISTILLATION=false
ENABLE_RUNTIME_GIT_PUSH=false
ENABLE_RUNTIME_CONFIG_AUTOTUNE=false
ENABLE_RETROSPECTIVE=false
ENABLE_META_OPTIMIZER=false
ENABLE_MISSED_OPPORTUNITY_ANALYZER=false
ENABLE_END_OF_SESSION_REVIEW=false

LLM_DAILY_BUDGET_USD=5
LLM_MAX_CALLS_PER_HOUR=8
MAX_DAILY_DRAWDOWN_USD=25
ENABLE_SENTIMENT_GATE=true
SENTIMENT_MIN_ABS_SCORE=0.08
SENTIMENT_DIRECTIONAL_FLOOR=0.05
SENTIMENT_MIN_ARTICLES=3

# LLM Provider options: BEDROCK, OPENAI
LLM_PROVIDER=BEDROCK
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_ID=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_NEWS_SUMMARY_MODEL_ID=gpt-4.1-mini
OPENAI_NEWS_SUMMARY_INPUT_USD_PER_1M=0.40
OPENAI_NEWS_SUMMARY_OUTPUT_USD_PER_1M=1.60

# Optional: News + sentiment enrichment APIs
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here

AUTO_RESTART_ON_BACKEND_CHANGES=true
